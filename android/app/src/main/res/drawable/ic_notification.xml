<?xml version="1.0" encoding="utf-8"?>
<!-- Small icon of the status bar and the notification drawer: the app's white pin logo (the same picture as the launcher
     icon). Android draws small icons as a white shape from the picture's transparency, so only its outline matters. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_logo"
    android:inset="2%" />
