# Copy this file to .env (git-ignored) and fill in the values. No real secrets in this example file.
API_BASE_URL=https://mototrack24.com/api
SOCKET_URL=https://mototrack24.com

# Google Maps key, read by the Android build (android/app/build.gradle). Rebuild the app after changing it.
GOOGLE_MAPS_API_KEY=

# DGePay (renewal payments). Get these from your DGePay merchant account.
# Use the UAT base URL while testing, the live one when you go live.
DGEPAY_BASE_URL=https://api-uat.dgepay.net/dipon/v3
DGEPAY_CLIENT_ID=
DGEPAY_API_KEY=
DGEPAY_SECRET_KEY=
