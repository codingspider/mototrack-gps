<?php namespace App\Http\Controllers;

use Illuminate\Support\Facades\Crypt;
use SimpleSoftwareIO\QrCode\BaconQrCodeGenerator;
use Tobuli\Helpers\PaymentLogo;
use Tobuli\Entities\Device;

class CertificateController extends Controller
{
    /**
     * Encrypt a device ID into a URL-safe token.
     */
    public static function encryptId($deviceId): string
    {
        return rtrim(strtr(base64_encode(Crypt::encryptString((string) $deviceId)), '+/', '-_'), '=');
    }

    /**
     * Decrypt a URL-safe token back to a device ID. Returns null on failure.
     */
    public static function decryptToken(string $token): ?string
    {
        try {
            $padded = strtr($token, '-_', '+/');
            if ($mod = strlen($padded) % 4)
                $padded .= str_repeat('=', 4 - $mod);

            $id = Crypt::decryptString(base64_decode($padded));

            return ctype_digit($id) ? $id : null;
        } catch (\Exception $e) {
            return null;
        }
    }

    public function show($token)
    {
        $deviceId = self::decryptToken($token);

        if (!$deviceId)
            abort(404);

        $device = Device::with(['users.client', 'icon', 'deviceType'])->find($deviceId);

        if (!$device)
            abort(404);

        $data = $this->certificateData($device);

        // the logo without the empty margin many uploaded files have, so it can be shown larger
        $data['company_logo'] = $this->trimmedLogo($data['company_logo']) ?: $data['company_logo'];

        return view('certificate', $data);
    }

    public function download($id)
    {
        // admin always, every other user only with the "device_certificate" permission
        abort_unless($this->user && $this->user->perm('devices', 'view')
            && ($this->user->isAdmin() || $this->user->perm('device_certificate', 'view')), 403);

        $device = $this->user->accessibleDevices()
            ->with(['users.client', 'icon', 'deviceType', 'traccar'])
            ->findOrFail($id);

        $data = $this->certificateData($device);
        $data['certificate_url'] = route('certificate.show', ['token' => self::encryptId($device->id)]);
        $svg = (new BaconQrCodeGenerator())->format('svg')->size(220)->margin(4)
            ->errorCorrection('M')->generate($data['certificate_url']);
        $data['qr_code'] = 'data:image/svg+xml;base64,' . base64_encode($svg);
        $data['company_logo'] = $this->localLogo($data['company_logo']);

        return response($this->renderPdf($data), 200, [
            'Content-Type' => 'application/pdf',
            'Content-Disposition' => 'attachment; filename="certificate-' . $device->id . '.pdf"',
            'Cache-Control' => 'private, no-store',
        ]);
    }

    private function renderPdf(array $data): string
    {
        // Render with the installed PDF engine; never return a multi-page certificate.
        for ($fontSize = 12; $fontSize >= 8; $fontSize -= 0.5) {
            $pdf = app('snappy.pdf')->getOutputFromHtml(
                view('online-certificate', $data + ['font_size' => $fontSize])->render(),
                [
                    'page-size' => 'A4', 'orientation' => 'Portrait',
                    // no page margins: the certificate paper (frame + background) fills the whole sheet
                    'margin-top' => '0mm', 'margin-bottom' => '0mm',
                    'margin-left' => '0mm', 'margin-right' => '0mm',
                    'encoding' => 'UTF-8', 'disable-javascript' => true,
                    'disable-local-file-access' => true,
                    // without this the engine lays the page out ~1024px wide and shrinks it (the sheet covered only ~78% of the page)
                    'disable-smart-shrinking' => true,
                    // a resource that fails to load makes wkhtmltopdf exit with code 1 even though the PDF was
                    // made; keep the PDF instead of failing the whole download
                    'load-error-handling' => 'ignore', 'load-media-error-handling' => 'ignore',
                ]
            );

            // wkhtmltopdf writes an uncompressed page dictionary for each page.
            if (preg_match_all('~/Type\s*/Page\b~', $pdf) === 1) {
                return $pdf;
            }
        }

        abort(422, 'The certificate details are too long to fit on one A4 page.');
    }

    private function localLogo($logo): ?string
    {
        $path = parse_url((string) $logo, PHP_URL_PATH);
        $root = realpath(public_path());
        $file = $path ? realpath(public_path(ltrim($path, '/'))) : false;

        if (!$file || strpos($file, $root . DIRECTORY_SEPARATOR) !== 0 || !is_file($file)) {
            $file = public_path('images/logo.png');
        }

        if (!is_file($file) || !in_array(strtolower(pathinfo($file, PATHINFO_EXTENSION)), ['png', 'jpg', 'jpeg'])) {
            return null;
        }

        return PaymentLogo::trimFile($file)
            ?: 'data:' . mime_content_type($file) . ';base64,' . base64_encode(file_get_contents($file));
    }

    /** Trimmed data: URI of a logo that is a local file under public/, or null (use the original URL). */
    private function trimmedLogo($logo): ?string
    {
        $path = parse_url((string) $logo, PHP_URL_PATH);
        $root = realpath(public_path());
        $file = $path ? realpath(public_path(ltrim($path, '/'))) : false;

        if (!$file || !$root || strpos($file, $root . DIRECTORY_SEPARATOR) !== 0 || !is_file($file)) {
            return null;
        }

        return PaymentLogo::trimFile($file);
    }

    private function certificateData(Device $device): array
    {
        $user = $device->users->first();
        $client = $user ? $user->client : null;
        $parameters = $device->parameters;
        if (!is_array($parameters)) {
            $parameters = json_decode((string) $parameters, true) ?: [];
        }

        // an empty date is stored as 0000-00-00 and must not be printed as a date
        $validDate = function ($value) {
            $value = (string) $value;

            return $value !== '' && substr($value, 0, 4) !== '0000' && strtotime($value) ? \Carbon\Carbon::parse($value) : null;
        };

        $expiry    = $validDate($device->expiration_date);
        $installed = $validDate($device->installation_date);
        $connected = $device->getStatus() !== Device::STATUS_OFFLINE;

        $data = [
            // Company / letterhead
            'company_name'    => settings('main_settings.company_name') ?: settings('main_settings.server_name'),
            // heading printed at the top of the certificate (the logo sits on the left below it)
            'header_title'    => 'Mototrack VTS Solution',
            'company_address' => settings('main_settings.company_address') ?: 'N/A',
            'company_phone'   => settings('main_settings.phone') ?: 'N/A',
            'company_email'   => settings('main_settings.email') ?: 'N/A',
            'company_logo'    => settings('main_settings.logo') ?: asset('images/logo.png'),
            'btrc_logo'       => 'https://track.itracker.com.bd/img/certificate/logs/btrc.png',
            'brta_logo'       => 'https://track.itracker.com.bd/img/certificate/logs/brta.png',
            'btrc_license'    => settings('main_settings.btrc_license'),

            // Customer / owner
            'customer_name'   => trim(($client->first_name ?? '') . ' ' . ($client->last_name ?? '')) ?: ($user->email ?? 'N/A'),
            'customer_address'=> $client->address ?? 'N/A',
            'customer_phone'  => $user->phone_number ?? 'N/A',
            'customer_email'  => $user->email ?? 'Nil',

            // Vehicle
            'registration_no' => $device->registration_number ?: ($device->plate_number ?: 'N/A'),
            'chassis_no'      => $device->vin ?: 'N/A',
            'engine_no'       => $parameters['engine_no'] ?? 'N/A',
            'vehicle_type'    => $device->deviceType->title ?? 'N/A',
            'brand_model'     => $device->device_model ?: $device->name,
            // every certified device has the SOS button: always shown as available
            'sos_button'      => 'Available',

            // Validity
            // company name (letters and digits, upper case) / device number padded to 3 digits, e.g. MOTOTRACK/006
            'certificate_no'  => (strtoupper(preg_replace('/[^A-Za-z0-9]/', '', (string) (settings('main_settings.company_name') ?: settings('main_settings.server_name')))) ?: 'VTS')
                . '/' . str_pad((string) $device->id, 3, '0', STR_PAD_LEFT),
            // issued on the day the certificate is downloaded / opened; valid till the device expiration date
            'issued_at'       => now()->format('d F Y'),
            'valid_until'     => $expiry ? $expiry->format('d F Y') : 'N/A',
            'subscription'    => $device->isExpired() ? 'Expired' : 'Active',
            'subscription_class' => $device->isExpired() ? 'text-danger' : 'status-active',
            'gps_connection'  => $connected ? 'Connected' : 'Disconnected',
            'gps_class'       => $connected ? 'status-connected' : 'text-danger',
            // Active / Inactive is the device's own activation flag (GPS connection above is the live link)
            'device_status'   => $device->active ? 'Active' : 'Inactive',
            'device_status_class' => $device->active ? 'status-active' : 'text-danger',
            'installed_at'    => $installed ? $installed->format('d F Y') : 'N/A',

            // Live track
            'live_track_url'  => settings('main_settings.live_track_url') ?? '#',
        ];

        return $data;
    }
}
